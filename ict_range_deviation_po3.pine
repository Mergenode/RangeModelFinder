//@version=6
indicator("ICT Range Deviation / PO3 Engine", "ICT RD/PO3", overlay = true, max_bars_back = 500, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 500)

// =============================================================================
// ICT Range Deviation / PO3 Engine
// Causal state machine: SEARCHING -> ACCUMULATION -> MANIPULATION ->
// CONFIRMATION -> EXPANSION -> COMPLETE / INVALID.
// All subjective ICT ideas are represented by configurable, documented proxies.
// =============================================================================

// --- Input groups -------------------------------------------------------------
string G_RANGE = "1. Range Detection"
string G_MANIP = "2. Manipulation"
string G_CONFIRM = "3. Confirmation"
string G_EXPAND = "4. Expansion"
string G_SCORE = "5. Quality & Lifecycle"
string G_VISUAL = "6. Visuals"
string G_ALERT = "7. Alerts & Debug"

int minAccBars = input.int(12, "Minimum accumulation bars", minval = 5, maxval = 100, group = G_RANGE)
int maxAccBars = input.int(40, "Maximum accumulation bars", minval = 10, maxval = 200, group = G_RANGE)
int rangeScanStep = input.int(2, "Range-length scan step", minval = 1, maxval = 10, tooltip = "Higher values reduce computation; lower values inspect more candidate lengths.", group = G_RANGE)
int minRHTouches = input.int(2, "Minimum RH touch runs", minval = 1, maxval = 10, group = G_RANGE)
int minRLTouches = input.int(2, "Minimum RL touch runs", minval = 1, maxval = 10, group = G_RANGE)
string toleranceMode = input.string("ATR", "Boundary tolerance method", options = ["Range %", "ATR", "Ticks"], group = G_RANGE)
float rangeTolerancePct = input.float(5.0, "Range tolerance (%)", minval = 0.1, maxval = 25.0, step = 0.1, group = G_RANGE)
float atrTolerance = input.float(0.20, "ATR tolerance", minval = 0.01, maxval = 2.0, step = 0.01, group = G_RANGE)
int tickTolerance = input.int(10, "Tick tolerance", minval = 1, maxval = 1000, group = G_RANGE)
int atrLength = input.int(14, "ATR length", minval = 2, maxval = 100, group = G_RANGE)
float maxRangeATR = input.float(4.0, "Maximum range size (ATR)", minval = 0.5, maxval = 20.0, step = 0.1, group = G_RANGE)
float minStability = input.float(45.0, "Minimum boundary stability", minval = 0.0, maxval = 100.0, step = 1.0, group = G_RANGE)

float maxNormalDeviationPct = input.float(50.0, "Maximum normal deviation (%)", minval = 5.0, maxval = 200.0, step = 1.0, group = G_MANIP)
int maxManipBars = input.int(7, "Maximum manipulation bars", minval = 1, maxval = 50, group = G_MANIP)
int fastReclaimStrongBars = input.int(3, "Strong fast-reclaim bars", minval = 1, maxval = 20, group = G_MANIP)
int fastReclaimMaxBars = input.int(7, "Maximum fast-reclaim bars", minval = 1, maxval = 50, group = G_MANIP)
bool allowExtendedExceptions = input.bool(true, "Allow extended-deviation exceptions", group = G_MANIP)
float hardMaxDeviationPct = input.float(125.0, "Hard maximum deviation (%)", minval = 50.0, maxval = 500.0, step = 5.0, group = G_MANIP)
float wickBodyThreshold = input.float(1.5, "Wick/body rejection threshold", minval = 0.1, maxval = 10.0, step = 0.1, group = G_MANIP)
float strongReactionThreshold = input.float(60.0, "Strong reaction score", minval = 0.0, maxval = 100.0, step = 1.0, group = G_MANIP)

float minBodyATR = input.float(0.55, "Minimum displacement body (ATR)", minval = 0.05, maxval = 3.0, step = 0.05, group = G_CONFIRM)
float minBodyRelative = input.float(1.25, "Minimum body vs recent average", minval = 0.25, maxval = 5.0, step = 0.05, group = G_CONFIRM)
float minDisplacementScore = input.float(55.0, "Minimum displacement score", minval = 0.0, maxval = 100.0, step = 1.0, group = G_CONFIRM)
bool requireCloseInside = input.bool(true, "Require close inside range", group = G_CONFIRM)
bool requireFVG = input.bool(false, "Require FVG", group = G_CONFIRM)
bool requireLiquidity = input.bool(false, "Require liquidity evidence", group = G_CONFIRM)
string confirmationStrictness = input.string("Balanced", "Confirmation strictness", options = ["Lenient", "Balanced", "Strict"], group = G_CONFIRM)
bool evidenceFVG = input.bool(true, "Evidence module: FVG", group = G_CONFIRM)
bool evidenceReaction = input.bool(true, "Evidence module: rejection", group = G_CONFIRM)
bool evidenceVolume = input.bool(true, "Evidence module: volume impulse", group = G_CONFIRM)

int expansionWindow = input.int(8, "Expansion evaluation bars", minval = 3, maxval = 50, group = G_EXPAND)
float weakBodyATR = input.float(0.25, "Weak candle body (ATR)", minval = 0.01, maxval = 1.0, step = 0.01, group = G_EXPAND)
float oppositePressureSensitivity = input.float(0.45, "Opposite pressure sensitivity", minval = 0.1, maxval = 0.9, step = 0.05, group = G_EXPAND)
float momentumSensitivity = input.float(0.75, "Momentum persistence threshold", minval = 0.1, maxval = 2.0, step = 0.05, group = G_EXPAND)
float strongExpansionThreshold = input.float(75.0, "Strong expansion score", minval = 0.0, maxval = 100.0, group = G_EXPAND)
float healthyExpansionThreshold = input.float(55.0, "Healthy expansion score", minval = 0.0, maxval = 100.0, group = G_EXPAND)
int maxExpansionBars = input.int(30, "Maximum expansion tracking bars", minval = 5, maxval = 200, group = G_EXPAND)

float weightAccumulation = input.float(25.0, "Weight: accumulation", minval = 0.0, maxval = 100.0, group = G_SCORE)
float weightManipulation = input.float(20.0, "Weight: manipulation", minval = 0.0, maxval = 100.0, group = G_SCORE)
float weightEvidence = input.float(15.0, "Weight: rejection/evidence", minval = 0.0, maxval = 100.0, group = G_SCORE)
float weightConfirmation = input.float(25.0, "Weight: confirmation", minval = 0.0, maxval = 100.0, group = G_SCORE)
float weightExpansion = input.float(15.0, "Weight: expansion", minval = 0.0, maxval = 100.0, group = G_SCORE)
float perfectThreshold = input.float(90.0, "Perfect score threshold", minval = 0.0, maxval = 100.0, group = G_SCORE)
float highQualityThreshold = input.float(75.0, "High Quality threshold", minval = 0.0, maxval = 100.0, group = G_SCORE)
float validThreshold = input.float(60.0, "Valid threshold", minval = 0.0, maxval = 100.0, group = G_SCORE)
float weakThreshold = input.float(40.0, "Weak threshold", minval = 0.0, maxval = 100.0, group = G_SCORE)
string minimumQuality = input.string("Valid+", "Minimum signal quality", options = ["All", "Valid+", "High Quality+", "Perfect Only"], group = G_SCORE)

bool showRange = input.bool(true, "Show range and equilibrium", group = G_VISUAL)
bool showManipulation = input.bool(true, "Show manipulation zone", group = G_VISUAL)
bool showPanel = input.bool(true, "Show information panel", group = G_VISUAL)
int hideOldAfterBars = input.int(300, "Hide completed structures after bars (0 = never)", minval = 0, maxval = 5000, group = G_VISUAL)
int maxHistoricalSetups = input.int(20, "Maximum historical structures", minval = 1, maxval = 75, group = G_VISUAL)

bool developingMode = input.bool(false, "Developing/repainting mode", tooltip = "When off, state transitions occur only on confirmed bars. When on, intrabar previews may disappear before the bar closes.", group = G_ALERT)
bool alertDeveloping = input.bool(true, "Alert: developing manipulation", group = G_ALERT)
bool alertConfirmed = input.bool(true, "Alert: confirmed entry", group = G_ALERT)
bool alertWeakening = input.bool(true, "Alert: expansion weakening", group = G_ALERT)
bool alertInvalid = input.bool(true, "Alert: structural failure", group = G_ALERT)
bool debugMode = input.bool(false, "Developer/debug mode", group = G_ALERT)

// --- State and helper constants ----------------------------------------------
int S_SEARCHING = 0
int S_ACCUMULATION = 1
int S_MANIPULATION = 2
int S_EXPANSION = 3
int S_COMPLETE = 4
int S_INVALID = 5

// Centralized sub-score weights. Phase weights above are user-configurable;
// these constants make each deterministic proxy auditable in one place.
float ACC_TOUCH_WEIGHT = 0.40
float ACC_STABILITY_WEIGHT = 0.30
float ACC_COMPRESSION_WEIGHT = 0.20
float ACC_DURATION_WEIGHT = 0.10
float EXP_PROGRESS_WEIGHT = 0.35
float EXP_DIRECTION_WEIGHT = 0.25
float EXP_MOMENTUM_WEIGHT = 0.25
float EXP_CLEANLINESS_WEIGHT = 0.15

f_clamp(float value, float lowBound, float highBound) =>
    math.max(lowBound, math.min(highBound, value))

f_safe_div(float numerator, float denominator, float fallback) =>
    math.abs(denominator) > 0.0 ? numerator / denominator : fallback

f_tolerance(float rangeSize, float atrValue) =>
    toleranceMode == "Range %" ? rangeSize * rangeTolerancePct * 0.01 : toleranceMode == "ATR" ? atrValue * atrTolerance : syminfo.mintick * tickTolerance

f_quality_name(float score) =>
    score >= perfectThreshold ? "Perfect" : score >= highQualityThreshold ? "High Quality" : score >= validThreshold ? "Valid" : score >= weakThreshold ? "Weak" : "Invalid"

f_accumulation_name(float score) =>
    score >= perfectThreshold ? "Perfect" : score >= validThreshold ? "Valid" : score >= weakThreshold ? "Weak" : "Invalid"

f_quality_pass(float score) =>
    minimumQuality == "All" ? score >= weakThreshold : minimumQuality == "Valid+" ? score >= validThreshold : minimumQuality == "High Quality+" ? score >= highQualityThreshold : score >= perfectThreshold

f_phase_name(int currentState) =>
    currentState == S_SEARCHING ? "SEARCHING" : currentState == S_ACCUMULATION ? "ACCUMULATION" : currentState == S_MANIPULATION ? "MANIPULATION" : currentState == S_EXPANSION ? "EXPANSION" : currentState == S_COMPLETE ? "COMPLETE" : "INVALID"

// A touch is a distinct visit to a boundary zone, not every consecutive candle
// that remains in it. Stability compares oldest and newest halves of the window.
f_evaluate_range(int length, float atrValue) =>
    float candidateHigh = high
    float candidateLow = low
    for i = 0 to length - 1
        candidateHigh := math.max(candidateHigh, high[i])
        candidateLow := math.min(candidateLow, low[i])
    float candidateSize = candidateHigh - candidateLow
    float tolerance = f_tolerance(candidateSize, atrValue)
    int highTouches = 0
    int lowTouches = 0
    bool wasHighZone = false
    bool wasLowZone = false
    float runningHigh = high[length - 1]
    float runningLow = low[length - 1]
    int boundaryExpansions = 0
    for step = 0 to length - 1
        int offset = length - 1 - step
        bool highZone = high[offset] >= candidateHigh - tolerance
        bool lowZone = low[offset] <= candidateLow + tolerance
        if highZone and not wasHighZone
            highTouches += 1
        if lowZone and not wasLowZone
            lowTouches += 1
        wasHighZone := highZone
        wasLowZone := lowZone
        if step > 0
            if high[offset] > runningHigh + tolerance
                boundaryExpansions += 1
            if low[offset] < runningLow - tolerance
                boundaryExpansions += 1
            runningHigh := math.max(runningHigh, high[offset])
            runningLow := math.min(runningLow, low[offset])
    int half = math.max(1, int(math.floor(length * 0.5)))
    float oldHigh = high[length - 1]
    float oldLow = low[length - 1]
    float newHigh = high
    float newLow = low
    for i = 0 to length - 1
        if i >= half
            oldHigh := math.max(oldHigh, high[i])
            oldLow := math.min(oldLow, low[i])
        else
            newHigh := math.max(newHigh, high[i])
            newLow := math.min(newLow, low[i])
    float drift = candidateSize > 0.0 ? (math.abs(oldHigh - newHigh) + math.abs(oldLow - newLow)) / candidateSize : 1.0
    float stabilityScore = f_clamp(100.0 * (1.0 - drift) - boundaryExpansions * 4.0, 0.0, 100.0)
    float rangeATR = f_safe_div(candidateSize, atrValue, 999.0)
    float compressionScore = f_clamp(100.0 * (1.0 - rangeATR / math.max(maxRangeATR, 0.01)), 0.0, 100.0)
    float touchScore = 50.0 * math.min(1.0, f_safe_div(highTouches, minRHTouches, 0.0)) + 50.0 * math.min(1.0, f_safe_div(lowTouches, minRLTouches, 0.0))
    float durationScore = f_clamp(100.0 * f_safe_div(length - minAccBars + 1, maxAccBars - minAccBars + 1, 0.0), 0.0, 100.0)
    float accumulationScore = touchScore * ACC_TOUCH_WEIGHT + stabilityScore * ACC_STABILITY_WEIGHT + compressionScore * ACC_COMPRESSION_WEIGHT + durationScore * ACC_DURATION_WEIGHT
    bool validCandidate = candidateSize >= syminfo.mintick * 5 and rangeATR <= maxRangeATR and highTouches >= minRHTouches and lowTouches >= minRLTouches and stabilityScore >= minStability
    [validCandidate, candidateHigh, candidateLow, highTouches, lowTouches, stabilityScore, compressionScore, accumulationScore, boundaryExpansions]

f_bull_fvg() =>
    not na(high[2]) and low > high[2]

f_bear_fvg() =>
    not na(low[2]) and high < low[2]

// Reaction score rewards rejection wick, close location, opposite close, and
// immediate displacement. It intentionally uses no future bar.
f_reaction_score(bool bullish, float atrValue) =>
    float body = math.abs(close - open)
    float candleRange = math.max(high - low, syminfo.mintick)
    float rejectionWick = bullish ? math.min(open, close) - low : high - math.max(open, close)
    float wickBody = f_safe_div(rejectionWick, math.max(body, syminfo.mintick), 0.0)
    float closeLocation = bullish ? f_safe_div(close - low, candleRange, 0.0) : f_safe_div(high - close, candleRange, 0.0)
    bool oppositeClose = bullish ? close > open : close < open
    float bodyATR = f_safe_div(body, atrValue, 0.0)
    f_clamp(math.min(wickBody / wickBodyThreshold, 1.0) * 40.0 + closeLocation * 25.0 + (oppositeClose ? 15.0 : 0.0) + math.min(bodyATR / minBodyATR, 1.0) * 20.0, 0.0, 100.0)

f_displacement_score(bool bullish, float atrValue, float recentBody) =>
    float body = math.abs(close - open)
    float candleRange = math.max(high - low, syminfo.mintick)
    bool directional = bullish ? close > open : close < open
    float closeLocation = bullish ? f_safe_div(close - low, candleRange, 0.0) : f_safe_div(high - close, candleRange, 0.0)
    float oppositeWick = bullish ? high - math.max(open, close) : math.min(open, close) - low
    float wickCleanliness = 1.0 - f_clamp(f_safe_div(oppositeWick, candleRange, 0.0), 0.0, 1.0)
    float atrComponent = math.min(f_safe_div(body, atrValue * minBodyATR, 0.0), 1.0) * 30.0
    float relativeComponent = math.min(f_safe_div(body, recentBody * minBodyRelative, 0.0), 1.0) * 20.0
    float closeComponent = closeLocation * 20.0
    float wickComponent = wickCleanliness * 10.0
    bool consecutive = bullish ? close[1] > open[1] : close[1] < open[1]
    float sequenceComponent = consecutive ? 10.0 : 0.0
    float fvgComponent = bullish ? (f_bull_fvg() ? 10.0 : 0.0) : (f_bear_fvg() ? 10.0 : 0.0)
    directional ? f_clamp(atrComponent + relativeComponent + closeComponent + wickComponent + sequenceComponent + fvgComponent, 0.0, 100.0) : 0.0

f_expansion_metrics(bool bullish, int barsInExpansion, float atrValue, float rangeSize, float entryPrice) =>
    int window = math.min(expansionWindow, barsInExpansion + 1)
    int directionalBars = 0
    int oppositeBars = 0
    int weakBars = 0
    int overlapBars = 0
    float directionalBody = 0.0
    float oppositeBody = 0.0
    for i = 0 to window - 1
        float body = math.abs(close[i] - open[i])
        bool directional = bullish ? close[i] > open[i] : close[i] < open[i]
        if directional
            directionalBars += 1
            directionalBody += body
        else
            oppositeBars += 1
            oppositeBody += body
        if body < atrValue * weakBodyATR
            weakBars += 1
        if i < window - 1
            float overlap = math.max(0.0, math.min(high[i], high[i + 1]) - math.max(low[i], low[i + 1]))
            float unionRange = math.max(math.max(high[i], high[i + 1]) - math.min(low[i], low[i + 1]), syminfo.mintick)
            if overlap / unionRange > 0.55
                overlapBars += 1
    float progress = bullish ? close - entryPrice : entryPrice - close
    float progressScore = f_clamp(f_safe_div(progress, math.max(rangeSize, atrValue), 0.0) * 100.0, 0.0, 100.0)
    float directionScore = f_safe_div(directionalBars, window, 0.0) * 100.0
    float momentumRatio = f_safe_div(directionalBody, math.max(oppositeBody, syminfo.mintick), 0.0)
    float momentumScore = math.min(momentumRatio / momentumSensitivity, 1.0) * 100.0
    float cleanlinessScore = 100.0 - f_safe_div(weakBars + overlapBars, window * 2.0, 0.0) * 100.0
    float expansionScore = f_clamp(progressScore * EXP_PROGRESS_WEIGHT + directionScore * EXP_DIRECTION_WEIGHT + momentumScore * EXP_MOMENTUM_WEIGHT + cleanlinessScore * EXP_CLEANLINESS_WEIGHT, 0.0, 100.0)
    float pressureRatio = f_safe_div(oppositeBody, math.max(directionalBody + oppositeBody, syminfo.mintick), 0.0)
    [expansionScore, pressureRatio, progress, directionalBars, oppositeBars, weakBars, overlapBars]

f_expansion_name(float score, float pressure, float progress) =>
    progress < 0.0 or pressure >= 0.75 ? "FAILED" : score >= strongExpansionThreshold and pressure < oppositePressureSensitivity * 0.65 ? "STRONG" : score >= healthyExpansionThreshold and pressure < oppositePressureSensitivity ? "HEALTHY" : "WEAKENING"

f_delete_line(line objectId) =>
    if not na(objectId)
        line.delete(objectId)

f_delete_box(box objectId) =>
    if not na(objectId)
        box.delete(objectId)

f_delete_label(label objectId) =>
    if not na(objectId)
        label.delete(objectId)

// --- Always-evaluated market measurements -----------------------------------
float atr = ta.atr(atrLength)
float recentBodyAverage = ta.sma(math.abs(close - open), 10)
float volumeAverage = ta.sma(volume, 20)
bool volumeImpulse = not na(volume) and not na(volumeAverage) and volume > volumeAverage * 1.5
bool processBar = developingMode or barstate.isconfirmed

if barstate.isfirst
    if maxAccBars < minAccBars
        runtime.error("Maximum accumulation bars must be greater than or equal to minimum accumulation bars.")
    if fastReclaimMaxBars < fastReclaimStrongBars
        runtime.error("Maximum fast-reclaim bars must be greater than or equal to strong fast-reclaim bars.")
    if strongExpansionThreshold < healthyExpansionThreshold
        runtime.error("Strong expansion threshold must be greater than or equal to healthy expansion threshold.")

// --- Persistent setup state --------------------------------------------------
var int state = S_SEARCHING
var int setupId = 0
var int accumulationStart = na
var int accumulationEnd = na
var int rangeLockedBar = na
var float rangeHigh = na
var float rangeLow = na
var float equilibrium = na
var float rangeSize = na
var int rhTouches = 0
var int rlTouches = 0
var float rangeStability = na
var float rangeCompression = na
var int rangeExpansions = 0
var float accumulationScore = na
var int direction = 0
var int manipulationStart = na
var int manipulationBars = 0
var float manipulationExtreme = na
var float deviationRatio = na
var float bestReactionScore = 0.0
var bool extendedExceptionAccepted = false
var string exceptionReason = "None"
var bool fvgSeen = false
var bool reactionEvidenceSeen = false
var bool volumeEvidenceSeen = false
var float confirmationScore = na
var int confirmationBar = na
var float entryPrice = na
var int expansionStart = na
var float expansionScore = na
var string expansionStatus = "N/A"
var string invalidationReason = ""
var string debugReason = "Searching for a stable range"
var bool weakeningAlerted = false

// Snapshot used by the panel when no new setup is active.
var int latestSetupId = 0
var int latestTerminalState = S_SEARCHING
var int latestDirection = 0
var float latestAccumulationScore = na
var int latestRHTouches = 0
var int latestRLTouches = 0
var float latestStability = na
var float latestDeviationRatio = na
var int latestManipulationBars = 0
var float latestConfirmationScore = na
var string latestEvidence = "None"
var string latestExpansionStatus = "N/A"
var float latestFinalScore = na

// --- Active drawings ---------------------------------------------------------
var line activeRH = na
var line activeRL = na
var line activeEQ = na
var line activeME = na
var box activeAccBox = na
var box activeManipBox = na
var label activeEntryLabel = na
var label activeStatusLabel = na

// Completed drawings are grouped by index and aged out together.
var array<line> historyRH = array.new<line>()
var array<line> historyRL = array.new<line>()
var array<line> historyEQ = array.new<line>()
var array<line> historyME = array.new<line>()
var array<box> historyAcc = array.new<box>()
var array<box> historyManip = array.new<box>()
var array<label> historyEntry = array.new<label>()
var array<label> historyStatus = array.new<label>()
var array<int> historyEndBar = array.new<int>()

// --- Per-bar events (alertconditions must remain in global scope) ------------
bool eventDevelopingBull = false
bool eventDevelopingBear = false
bool eventConfirmedLong = false
bool eventConfirmedShort = false
bool eventWeakening = false
bool eventInvalidated = false

// --- Historical-object retention --------------------------------------------
if array.size(historyEndBar) > 0
    bool tooOld = hideOldAfterBars > 0 and bar_index - array.get(historyEndBar, 0) > hideOldAfterBars
    bool tooMany = array.size(historyEndBar) > maxHistoricalSetups
    if tooOld or tooMany
        f_delete_line(array.shift(historyRH))
        f_delete_line(array.shift(historyRL))
        f_delete_line(array.shift(historyEQ))
        f_delete_line(array.shift(historyME))
        f_delete_box(array.shift(historyAcc))
        f_delete_box(array.shift(historyManip))
        f_delete_label(array.shift(historyEntry))
        f_delete_label(array.shift(historyStatus))
        array.shift(historyEndBar)

// --- State machine -----------------------------------------------------------
if processBar and not na(atr) and bar_index >= maxAccBars
    if state == S_SEARCHING
        bool found = false
        float bestScore = -1.0
        int bestLength = na
        float bestHigh = na
        float bestLow = na
        int bestHighTouches = 0
        int bestLowTouches = 0
        float bestStability = na
        float bestCompression = na
        int bestExpansions = 0
        int usableMax = math.max(minAccBars, maxAccBars)
        for length = minAccBars to usableMax by rangeScanStep
            [candidateValid, candidateHigh, candidateLow, candidateRHTouches, candidateRLTouches, candidateStability, candidateCompression, candidateScore, candidateExpansions] = f_evaluate_range(length, atr)
            if candidateValid and candidateScore > bestScore
                found := true
                bestScore := candidateScore
                bestLength := length
                bestHigh := candidateHigh
                bestLow := candidateLow
                bestHighTouches := candidateRHTouches
                bestLowTouches := candidateRLTouches
                bestStability := candidateStability
                bestCompression := candidateCompression
                bestExpansions := candidateExpansions
        if found
            setupId += 1
            state := S_ACCUMULATION
            accumulationStart := bar_index - bestLength + 1
            accumulationEnd := bar_index
            rangeLockedBar := bar_index
            rangeHigh := bestHigh
            rangeLow := bestLow
            rangeSize := bestHigh - bestLow
            equilibrium := (bestHigh + bestLow) * 0.5
            rhTouches := bestHighTouches
            rlTouches := bestLowTouches
            rangeStability := bestStability
            rangeCompression := bestCompression
            rangeExpansions := bestExpansions
            accumulationScore := bestScore
            direction := 0
            invalidationReason := ""
            debugReason := "Accepted range: both boundaries revisited and stability passed"
            if showRange
                activeRH := line.new(accumulationStart, rangeHigh, bar_index, rangeHigh, color = color.new(color.red, 5), width = 2)
                activeRL := line.new(accumulationStart, rangeLow, bar_index, rangeLow, color = color.new(color.lime, 5), width = 2)
                activeEQ := line.new(accumulationStart, equilibrium, bar_index, equilibrium, color = color.new(color.silver, 25), style = line.style_dashed)
                activeAccBox := box.new(accumulationStart, rangeHigh, bar_index, rangeLow, bgcolor = color.new(color.blue, 90), border_color = color.new(color.blue, 45), text = "ACC", text_color = color.new(color.white, 30))
        else
            debugReason := "Rejected range: touches, compression, or stability below threshold"

    else if state == S_ACCUMULATION
        float tolerance = f_tolerance(rangeSize, atr)
        bool brokeBelow = low < rangeLow - tolerance
        bool brokeAbove = high > rangeHigh + tolerance
        if not na(activeRH)
            line.set_x2(activeRH, bar_index)
            line.set_x2(activeRL, bar_index)
            line.set_x2(activeEQ, bar_index)
            box.set_right(activeAccBox, bar_index)
        if brokeBelow and brokeAbove
            state := S_INVALID
            invalidationReason := "Both range boundaries violated on one bar"
            debugReason := "Invalidated: ambiguous two-sided deviation"
            eventInvalidated := true
        else if brokeBelow or brokeAbove
            state := S_MANIPULATION
            accumulationEnd := bar_index - 1
            manipulationStart := bar_index
            manipulationBars := 1
            direction := brokeBelow ? 1 : -1
            manipulationExtreme := brokeBelow ? low : high
            deviationRatio := brokeBelow ? (rangeLow - manipulationExtreme) / rangeSize : (manipulationExtreme - rangeHigh) / rangeSize
            bestReactionScore := f_reaction_score(direction == 1, atr)
            reactionEvidenceSeen := evidenceReaction and bestReactionScore >= strongReactionThreshold
            fvgSeen := evidenceFVG and (direction == 1 ? f_bull_fvg() : f_bear_fvg())
            volumeEvidenceSeen := evidenceVolume and volumeImpulse
            extendedExceptionAccepted := false
            exceptionReason := "None"
            weakeningAlerted := false
            debugReason := str.format("Manipulation detected: {0,number,#.0}%", deviationRatio * 100.0)
            eventDevelopingBull := direction == 1
            eventDevelopingBear := direction == -1
            if showManipulation
                float zoneTop = direction == 1 ? rangeLow : manipulationExtreme
                float zoneBottom = direction == 1 ? manipulationExtreme : rangeHigh
                activeManipBox := box.new(bar_index, zoneTop, bar_index, zoneBottom, bgcolor = color.new(direction == 1 ? color.lime : color.red, 86), border_color = color.new(direction == 1 ? color.lime : color.red, 35), text = "MANIPULATION", text_color = color.new(color.white, 15))
                activeME := line.new(bar_index, manipulationExtreme, bar_index, manipulationExtreme, color = direction == 1 ? color.lime : color.red, style = line.style_dotted)
        else if bar_index - accumulationStart + 1 > maxAccBars
            state := S_INVALID
            invalidationReason := "Accumulation expired without deviation"
            debugReason := "Invalidated: no manipulation before maximum accumulation duration"
            eventInvalidated := true

    else if state == S_MANIPULATION
        manipulationBars := bar_index - manipulationStart + 1
        manipulationExtreme := direction == 1 ? math.min(manipulationExtreme, low) : math.max(manipulationExtreme, high)
        deviationRatio := direction == 1 ? (rangeLow - manipulationExtreme) / rangeSize : (manipulationExtreme - rangeHigh) / rangeSize
        float reactionNow = f_reaction_score(direction == 1, atr)
        bestReactionScore := math.max(bestReactionScore, reactionNow)
        reactionEvidenceSeen := reactionEvidenceSeen or (evidenceReaction and reactionNow >= strongReactionThreshold)
        fvgSeen := fvgSeen or (evidenceFVG and (direction == 1 ? f_bull_fvg() : f_bear_fvg()))
        volumeEvidenceSeen := volumeEvidenceSeen or (evidenceVolume and volumeImpulse)
        bool reclaimed = direction == 1 ? (requireCloseInside ? close > rangeLow : high > rangeLow) : (requireCloseInside ? close < rangeHigh : low < rangeHigh)
        bool fastReclaim = reclaimed and manipulationBars <= fastReclaimMaxBars
        float body = math.abs(close - open)
        float rejectWick = direction == 1 ? math.min(open, close) - low : high - math.max(open, close)
        bool wickDominant = f_safe_div(rejectWick, math.max(body, syminfo.mintick), 0.0) >= wickBodyThreshold
        bool closeBackNormalArea = direction == 1 ? close >= rangeLow - rangeSize * maxNormalDeviationPct * 0.01 : close <= rangeHigh + rangeSize * maxNormalDeviationPct * 0.01
        bool wickException = wickDominant and closeBackNormalArea
        bool reactionException = bestReactionScore >= strongReactionThreshold
        bool beyondNormal = deviationRatio > maxNormalDeviationPct * 0.01
        bool exceptionValid = allowExtendedExceptions and (fastReclaim or wickException or reactionException)
        if beyondNormal and exceptionValid
            extendedExceptionAccepted := true
            exceptionReason := fastReclaim ? (manipulationBars <= fastReclaimStrongBars ? "Fast strong reclaim" : "Fast reclaim") : wickException ? "Wick-based extension" : "Strong reaction"
        float displacement = f_displacement_score(direction == 1, atr, recentBodyAverage)
        float strictnessAdjustment = confirmationStrictness == "Lenient" ? -10.0 : confirmationStrictness == "Strict" ? 10.0 : 0.0
        bool displacementPassed = displacement >= f_clamp(minDisplacementScore + strictnessAdjustment, 0.0, 100.0)
        bool fvgPassed = not requireFVG or (direction == 1 ? f_bull_fvg() : f_bear_fvg()) or fvgSeen
        bool anyLiquidityEvidence = fvgSeen or reactionEvidenceSeen or volumeEvidenceSeen
        bool liquidityPassed = not requireLiquidity or anyLiquidityEvidence
        bool deviationPassed = not beyondNormal or extendedExceptionAccepted
        float durationScore = manipulationBars <= fastReclaimStrongBars ? 100.0 : f_clamp(100.0 * (1.0 - f_safe_div(manipulationBars - fastReclaimStrongBars, math.max(fastReclaimMaxBars - fastReclaimStrongBars, 1), 0.0)), 35.0, 100.0)
        float depthScore = f_clamp(100.0 * (1.0 - math.abs(deviationRatio - 0.25) / 0.75), 0.0, 100.0)
        float provisionalManipulationScore = depthScore * 0.60 + durationScore * 0.40
        bool qualityCanPass = f_quality_pass((accumulationScore * weightAccumulation + provisionalManipulationScore * weightManipulation + bestReactionScore * weightEvidence + displacement * weightConfirmation) / math.max(weightAccumulation + weightManipulation + weightEvidence + weightConfirmation, 0.01))
        if not na(activeRH)
            line.set_x2(activeRH, bar_index)
            line.set_x2(activeRL, bar_index)
            line.set_x2(activeEQ, bar_index)
        if not na(activeME)
            line.set_xy1(activeME, manipulationStart, manipulationExtreme)
            line.set_xy2(activeME, bar_index, manipulationExtreme)
        if not na(activeManipBox)
            box.set_right(activeManipBox, bar_index)
            if direction == 1
                box.set_bottom(activeManipBox, manipulationExtreme)
            else
                box.set_top(activeManipBox, manipulationExtreme)
        if deviationRatio > hardMaxDeviationPct * 0.01
            state := S_INVALID
            invalidationReason := "Deviation exceeded hard maximum"
            debugReason := str.format("Invalidated: deviation {0,number,#.0}% exceeded hard cap", deviationRatio * 100.0)
            eventInvalidated := true
        else if reclaimed and deviationPassed and displacementPassed and fvgPassed and liquidityPassed and qualityCanPass
            state := S_EXPANSION
            confirmationBar := bar_index
            expansionStart := bar_index
            confirmationScore := displacement
            entryPrice := close
            expansionScore := 50.0
            expansionStatus := "HEALTHY"
            debugReason := beyondNormal ? str.format(">normal exception accepted: {0}", exceptionReason) : "Confirmed: reclaim plus directional displacement"
            activeEntryLabel := label.new(bar_index, direction == 1 ? low : high, direction == 1 ? "LONG RD" : "SHORT RD", style = direction == 1 ? label.style_label_up : label.style_label_down, color = direction == 1 ? color.lime : color.red, textcolor = color.black, size = size.small)
            eventConfirmedLong := direction == 1
            eventConfirmedShort := direction == -1
        else if manipulationBars >= maxManipBars
            state := S_INVALID
            invalidationReason := reclaimed ? "Reclaim confirmation filters failed" : "Manipulation duration expired"
            debugReason := reclaimed ? "Confirmation rejected: displacement, evidence, deviation, or quality filter" : "Invalidated: manipulation did not reclaim in time"
            eventInvalidated := true
        else
            debugReason := beyondNormal and not exceptionValid ? str.format("Deviation {0,number,#.0}%: waiting for exception evidence", deviationRatio * 100.0) : reclaimed and not displacementPassed ? str.format("Reclaim seen; displacement {0,number,#.0} below threshold", displacement) : "Manipulation active; waiting for reclaim"

    else if state == S_EXPANSION
        int expansionBars = bar_index - expansionStart
        [newExpansionScore, pressureRatio, progress, directionalBars, oppositeBars, weakBars, overlapBars] = f_expansion_metrics(direction == 1, expansionBars, atr, rangeSize, entryPrice)
        string previousExpansionStatus = expansionStatus
        expansionScore := newExpansionScore
        expansionStatus := f_expansion_name(expansionScore, pressureRatio, progress)
        bool structuralFailure = direction == 1 ? close < manipulationExtreme : close > manipulationExtreme
        if not na(activeRH)
            line.set_x2(activeRH, bar_index)
            line.set_x2(activeRL, bar_index)
            line.set_x2(activeEQ, bar_index)
        if not na(activeME)
            line.set_x2(activeME, bar_index)
        if expansionStatus == "WEAKENING" and previousExpansionStatus != "WEAKENING" and not weakeningAlerted
            eventWeakening := true
            weakeningAlerted := true
            debugReason := str.format("Expansion downgraded: pressure {0,number,#.0}%, weak candles {1}", pressureRatio * 100.0, weakBars)
        else if expansionStatus == "STRONG" or expansionStatus == "HEALTHY"
            debugReason := str.format("Expansion {0}: score {1,number,#.0}", expansionStatus, expansionScore)
        if structuralFailure or expansionStatus == "FAILED"
            state := S_INVALID
            invalidationReason := structuralFailure ? "Close beyond manipulation extreme" : "Expansion structurally failed"
            debugReason := str.format("Invalidated: {0}", invalidationReason)
            eventInvalidated := true
        else if expansionBars >= maxExpansionBars
            state := S_COMPLETE
            debugReason := str.format("Lifecycle complete: final expansion {0}", expansionStatus)

    // Finalize any terminal setup without erasing its confirmed history.
    if state == S_COMPLETE or state == S_INVALID
        float manipulationDepthScore = f_clamp(100.0 * (1.0 - math.abs(nz(deviationRatio, 1.0) - 0.25) / 0.75), 0.0, 100.0)
        float manipulationComponent = manipulationDepthScore * 0.60 + f_clamp(100.0 * (1.0 - f_safe_div(nz(manipulationBars, maxManipBars), maxManipBars, 1.0)), 0.0, 100.0) * 0.40
        float evidenceComponent = f_clamp(bestReactionScore * 0.65 + (fvgSeen ? 20.0 : 0.0) + (volumeEvidenceSeen ? 15.0 : 0.0), 0.0, 100.0)
        float totalWeight = weightAccumulation + weightManipulation + weightEvidence + weightConfirmation + weightExpansion
        float finalScore = (nz(accumulationScore) * weightAccumulation + manipulationComponent * weightManipulation + evidenceComponent * weightEvidence + nz(confirmationScore) * weightConfirmation + nz(expansionScore) * weightExpansion) / math.max(totalWeight, 0.01)
        latestSetupId := setupId
        latestTerminalState := state
        latestDirection := direction
        latestAccumulationScore := accumulationScore
        latestRHTouches := rhTouches
        latestRLTouches := rlTouches
        latestStability := rangeStability
        latestDeviationRatio := deviationRatio
        latestManipulationBars := manipulationBars
        latestConfirmationScore := confirmationScore
        latestEvidence := fvgSeen ? (volumeEvidenceSeen ? "FVG + Volume" : "FVG") : reactionEvidenceSeen ? (volumeEvidenceSeen ? "Reaction + Volume" : "Reaction") : volumeEvidenceSeen ? "Volume" : "None"
        latestExpansionStatus := expansionStatus
        latestFinalScore := finalScore
        string terminalText = state == S_COMPLETE ? str.format("{0} EXPANSION\n#{1} | {2,number,#}/100", expansionStatus, setupId, finalScore) : str.format("INVALID\n{0}", invalidationReason)
        float terminalY = direction == 1 ? nz(rangeHigh, high) : nz(rangeLow, low)
        activeStatusLabel := label.new(bar_index, terminalY, terminalText, style = label.style_label_left, color = state == S_COMPLETE ? color.new(color.blue, 20) : color.new(color.gray, 25), textcolor = color.white, size = size.tiny)
        array.push(historyRH, activeRH)
        array.push(historyRL, activeRL)
        array.push(historyEQ, activeEQ)
        array.push(historyME, activeME)
        array.push(historyAcc, activeAccBox)
        array.push(historyManip, activeManipBox)
        array.push(historyEntry, activeEntryLabel)
        array.push(historyStatus, activeStatusLabel)
        array.push(historyEndBar, bar_index)
        activeRH := na
        activeRL := na
        activeEQ := na
        activeME := na
        activeAccBox := na
        activeManipBox := na
        activeEntryLabel := na
        activeStatusLabel := na
        // Start looking for a new, non-overlapping structure on the next bar.
        state := S_SEARCHING
        accumulationStart := na
        accumulationEnd := na
        rangeLockedBar := na
        rangeHigh := na
        rangeLow := na
        equilibrium := na
        rangeSize := na
        rhTouches := 0
        rlTouches := 0
        rangeStability := na
        rangeCompression := na
        rangeExpansions := 0
        accumulationScore := na
        direction := 0
        manipulationStart := na
        manipulationBars := 0
        manipulationExtreme := na
        deviationRatio := na
        bestReactionScore := 0.0
        extendedExceptionAccepted := false
        exceptionReason := "None"
        fvgSeen := false
        reactionEvidenceSeen := false
        volumeEvidenceSeen := false
        confirmationScore := na
        confirmationBar := na
        entryPrice := na
        expansionStart := na
        expansionScore := na
        expansionStatus := "N/A"
        weakeningAlerted := false

// --- Provisional score and compact information panel -------------------------
float currentManipScore = not na(deviationRatio) ? f_clamp(100.0 * (1.0 - math.abs(deviationRatio - 0.25) / 0.75), 0.0, 100.0) : 0.0
float currentEvidenceScore = f_clamp(bestReactionScore * 0.65 + (fvgSeen ? 20.0 : 0.0) + (volumeEvidenceSeen ? 15.0 : 0.0), 0.0, 100.0)
float currentWeight = weightAccumulation + (state >= S_MANIPULATION ? weightManipulation + weightEvidence : 0.0) + (state >= S_EXPANSION ? weightConfirmation + weightExpansion : 0.0)
float currentScore = currentWeight > 0.0 ? (nz(accumulationScore) * weightAccumulation + currentManipScore * weightManipulation + currentEvidenceScore * weightEvidence + nz(confirmationScore) * weightConfirmation + nz(expansionScore) * weightExpansion) / currentWeight : 0.0
string evidenceText = fvgSeen ? (volumeEvidenceSeen ? "FVG + Volume" : "FVG") : reactionEvidenceSeen ? (volumeEvidenceSeen ? "Reaction + Volume" : "Reaction") : volumeEvidenceSeen ? "Volume" : "None"
bool useLatest = state == S_SEARCHING and latestSetupId > 0
int panelSetupId = useLatest ? latestSetupId : setupId
int panelState = useLatest ? latestTerminalState : state
int panelDirection = useLatest ? latestDirection : direction
float panelAccumulationScore = useLatest ? latestAccumulationScore : accumulationScore
int panelRHTouches = useLatest ? latestRHTouches : rhTouches
int panelRLTouches = useLatest ? latestRLTouches : rlTouches
float panelStability = useLatest ? latestStability : rangeStability
float panelDeviationRatio = useLatest ? latestDeviationRatio : deviationRatio
int panelManipulationBars = useLatest ? latestManipulationBars : manipulationBars
float panelConfirmationScore = useLatest ? latestConfirmationScore : confirmationScore
string panelEvidence = useLatest ? latestEvidence : evidenceText
string panelExpansionStatus = useLatest ? latestExpansionStatus : expansionStatus
float panelScore = useLatest ? latestFinalScore : currentScore
string directionText = panelDirection == 1 ? "LONG" : panelDirection == -1 ? "SHORT" : "N/A"

var table panel = table.new(position.top_right, 2, 12, bgcolor = color.new(color.black, 15), frame_color = color.new(color.silver, 60), frame_width = 1)
if barstate.islast
    if showPanel
        table.cell(panel, 0, 0, "Range Deviation", bgcolor = color.new(color.blue, 55), text_color = color.white)
        table.cell(panel, 1, 0, str.format("#{0}", panelSetupId), bgcolor = color.new(color.blue, 55), text_color = color.white)
        table.cell(panel, 0, 1, "Direction", text_color = color.silver)
        table.cell(panel, 1, 1, directionText, text_color = panelDirection == 1 ? color.lime : panelDirection == -1 ? color.red : color.silver)
        table.cell(panel, 0, 2, "Phase", text_color = color.silver)
        table.cell(panel, 1, 2, useLatest ? "LATEST " + f_phase_name(panelState) : f_phase_name(panelState), text_color = color.white)
        table.cell(panel, 0, 3, "Range quality", text_color = color.silver)
        table.cell(panel, 1, 3, f_accumulation_name(nz(panelAccumulationScore)), text_color = color.white)
        table.cell(panel, 0, 4, "RH / RL touches", text_color = color.silver)
        table.cell(panel, 1, 4, str.format("{0} / {1}", panelRHTouches, panelRLTouches), text_color = color.white)
        table.cell(panel, 0, 5, "Stability", text_color = color.silver)
        table.cell(panel, 1, 5, str.format("{0,number,#}%", nz(panelStability)), text_color = color.white)
        table.cell(panel, 0, 6, "Deviation", text_color = color.silver)
        table.cell(panel, 1, 6, na(panelDeviationRatio) ? "N/A" : str.format("{0,number,#.0}%", panelDeviationRatio * 100.0), text_color = color.white)
        table.cell(panel, 0, 7, "Deviation bars", text_color = color.silver)
        table.cell(panel, 1, 7, str.tostring(panelManipulationBars), text_color = color.white)
        table.cell(panel, 0, 8, "Reclaim", text_color = color.silver)
        table.cell(panel, 1, 8, na(panelConfirmationScore) ? "Pending" : str.format("{0,number,#}", panelConfirmationScore), text_color = color.white)
        table.cell(panel, 0, 9, "Evidence", text_color = color.silver)
        table.cell(panel, 1, 9, panelEvidence, text_color = color.white)
        table.cell(panel, 0, 10, "Expansion", text_color = color.silver)
        table.cell(panel, 1, 10, panelExpansionStatus, text_color = panelExpansionStatus == "STRONG" ? color.lime : panelExpansionStatus == "WEAKENING" or panelExpansionStatus == "FAILED" ? color.orange : color.white)
        table.cell(panel, 0, 11, debugMode ? "Debug" : "Score", text_color = color.silver)
        table.cell(panel, 1, 11, debugMode ? debugReason : str.format("{0,number,#}/100", nz(panelScore)), text_color = color.white)
    else
        table.clear(panel, 0, 0, 1, 11)

// Debug messages occur only at transition/diagnostic bars to limit clutter.
bool debugEvent = debugMode and processBar and (eventDevelopingBull or eventDevelopingBear or eventConfirmedLong or eventConfirmedShort or eventWeakening or eventInvalidated)
if debugEvent
    label.new(bar_index, high + atr * 0.4, debugReason, style = label.style_label_down, color = color.new(color.black, 15), textcolor = color.yellow, size = size.tiny)

// Data Window telemetry supports staged visual backtesting and CSV export.
plot(state, "Telemetry: State (0 Search, 1 Acc, 2 Manip, 3 Expansion)", display = display.data_window)
plot(setupId, "Telemetry: Setup ID", display = display.data_window)
plot(direction, "Telemetry: Direction (1 Long, -1 Short)", display = display.data_window)
plot(rangeHigh, "Telemetry: Range High", display = display.data_window)
plot(rangeLow, "Telemetry: Range Low", display = display.data_window)
plot(equilibrium, "Telemetry: Equilibrium", display = display.data_window)
plot(deviationRatio * 100.0, "Telemetry: Deviation %", display = display.data_window)
plot(currentScore, "Telemetry: Provisional Score", display = display.data_window)
plot(confirmationScore, "Telemetry: Confirmation Score", display = display.data_window)
plot(expansionScore, "Telemetry: Expansion Score", display = display.data_window)
plot(eventConfirmedLong ? 1 : eventConfirmedShort ? -1 : 0, "Telemetry: Confirmed Signal", display = display.data_window)
plot(eventInvalidated ? 1 : 0, "Telemetry: Invalidation Event", display = display.data_window)

// --- Alerts ------------------------------------------------------------------
alertcondition(alertDeveloping and eventDevelopingBull, "Potential bullish Range Deviation", "Potential bullish Range Deviation detected on {{ticker}} {{interval}}")
alertcondition(alertDeveloping and eventDevelopingBear, "Potential bearish Range Deviation", "Potential bearish Range Deviation detected on {{ticker}} {{interval}}")
alertcondition(alertConfirmed and eventConfirmedLong, "Confirmed LONG Range Deviation", "Confirmed LONG Range Deviation on {{ticker}} {{interval}} at {{close}}")
alertcondition(alertConfirmed and eventConfirmedShort, "Confirmed SHORT Range Deviation", "Confirmed SHORT Range Deviation on {{ticker}} {{interval}} at {{close}}")
alertcondition(alertWeakening and eventWeakening, "Range Deviation expansion weakening", "Range Deviation expansion weakening on {{ticker}} {{interval}}")
alertcondition(alertInvalid and eventInvalidated, "Range Deviation setup invalidated", "Range Deviation setup invalidated on {{ticker}} {{interval}}")
